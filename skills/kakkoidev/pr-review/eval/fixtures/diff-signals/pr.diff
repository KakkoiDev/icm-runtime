+@RequireResource(Resource.NOTE)
+@Controller('attachments')
+export class AttachmentsController {
+  @Get('targets/:targetType/:targetId/attachments')
+  list(@Param('targetType') targetType: string, @Param('targetId') targetId: string) {
+    return this.service.list(targetType, targetId)
+  }
+
+  @Post(':attachmentId/uses')
+  use(@Param('attachmentId') attachmentId: string) {
+    return this.service.use(attachmentId)
+  }
+
+  @Post('import')
+  import() {
+    return this.service.importFromNotes()
+  }
+}
+
+router.delete('/attachments/:id', handler)
+router.get('/health', health)
