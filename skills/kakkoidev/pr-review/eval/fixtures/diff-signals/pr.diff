diff --git a/src/attachments/attachments.service.ts b/src/attachments/attachments.service.ts
--- a/src/attachments/attachments.service.ts
+++ b/src/attachments/attachments.service.ts
@@ -10,3 +10,12 @@ export class AttachmentsService {
   constructor(private readonly db: Db) {}
+
+  async importFromNotes() {
+    const rows = await this.db.note.findMany({ include: { tags: true } })
+    const { count } = await this.db.attachment.createMany({
+      data: rows.map(toAttachment),
+      skipDuplicates: true,
+    })
+    return count
+  }
 }
