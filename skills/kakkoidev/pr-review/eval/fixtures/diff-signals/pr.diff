+export function AttachmentsBlock({ targetId }: Props) {
+  const { data, isLoading } = useGetAttachmentsQuery(
+    { targetId },
+  )
+  const [createAttachment, { isLoading: isCreating }] =
+    useCreateAttachmentMutation()
+  const [useAttachment] = useUseAttachmentMutation()
+  const { mutate } = useMutation({ mutationFn: save })
+  const { data: tags } = useQuery({ queryKey: ['tags'] })
+  const { data: users } = useSWR('/users', fetcher)
+  const { data: notes, isError } = useGetNotesQuery({ targetId })
+  const { data: other, error } = useQuery({ queryKey: ['other'] })
+  const { data: a, status } = useGetAQuery()
+  const [trigger, { isPending }] = useSaveMutation()
+  const { mutate: m2, isPending: saving } = useMutation({ mutationFn: save })
+  const [fetchLazy] = useLazyGetThingQuery()
+  const { data: s } = useSuspenseQuery({ queryKey: ['s'] })
+  const query = useGetWholeQuery()
+  const [open, setOpen] = useState(false)
+  return null
+}
