+CREATE TABLE "Attachment" (
+    "id" TEXT NOT NULL,
+    "tenantId" TEXT NOT NULL DEFAULT tenant_id(),
+    "noteId" TEXT,
+    "s3Key" TEXT,
+    CONSTRAINT "Attachment_pkey" PRIMARY KEY ("id")
+);
+
+CREATE TABLE "AttachmentUse" (
+    "id" TEXT NOT NULL,
+    "attachmentId" TEXT NOT NULL,
+    CONSTRAINT "AttachmentUse_pkey" PRIMARY KEY ("id")
+);
+
+CREATE TABLE IF NOT EXISTS "Scoped" (
+    "id" TEXT NOT NULL
+);
+
+-- Row level security, same as Note.
+SELECT enable_tenant_rls('Attachment');
+CREATE POLICY scoped_policy ON "Scoped" USING (true);
+
