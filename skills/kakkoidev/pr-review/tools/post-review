#!/bin/sh
# post-review: add anchored review comments to a GitHub PR as ONE PENDING review.
#
# Usage: post-review <owner/repo> <pr#> <review-comments.json> [--dry-run] [--body-file <f>]
#
# INVARIANT - NEVER SUBMITS. This tool only ever creates a PENDING (draft) review. It
# passes no `event`, so nothing is published and the PR author is not notified until the
# human reads it and clicks Submit in the GitHub UI. There is no code path here that
# submits/approves/requests-changes or posts a plain comment - publication is the human's gate.
#
# Behaviour:
#   - 0 comments in the payload -> no-op (exit 0).
#   - An existing pending review by the current user -> STOP (exit 6) and report it. It
#     never appends to, replaces, or adds a second review next to one the human holds.
#   - Otherwise CREATE one pending review (REST, no event) with all comments, and the
#     summary --body-file if given. The AI-review disclaimer below is prepended to that
#     body unconditionally. On success stdout is exactly the pending review's URL.
#   - --dry-run: report the decision and per-comment action; write nothing.
#
# Read-only inputs otherwise. Requires gh (authenticated) + jq.
set -eu

# Prepended to the review body on create. Says three things a human needs in the first
# five seconds: a machine wrote this, an agent triages it, and nothing is owed in reply.
AI_DISCLAIMER='## 🤖 AI-generated review

An automated agent wrote this review. No human has read these findings yet.

It exists so **another agent can triage it** and fix only what should be fixed. It is not a
verdict on the work and it is not a review you owe a reply to.

Findings are hypotheses, not conclusions. Some of them are wrong. If one looks wrong to you,
it probably is - say so in a word and move on, there is nothing here to defend against.
'

OR=${1:-}; PR=${2:-}; PAYLOAD=${3:-}
[ -n "$OR" ] && [ -n "$PR" ] && [ -n "$PAYLOAD" ] \
  || { echo "usage: post-review <owner/repo> <pr#> <review-comments.json> [--dry-run] [--body-file <f>]" >&2; exit 2; }
shift 3 || true
DRY=0; BODYFILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --body-file) shift; BODYFILE=${1:-} ;;
    *) echo "post-review: unknown arg: $1" >&2; exit 2 ;;
  esac
  shift
done
[ -f "$PAYLOAD" ] || { echo "post-review: payload not found: $PAYLOAD" >&2; exit 2; }
command -v gh >/dev/null 2>&1 || { echo "post-review: gh not found" >&2; exit 3; }
command -v jq >/dev/null 2>&1 || { echo "post-review: jq not found" >&2; exit 3; }

N=$(jq 'length' "$PAYLOAD")
if [ "$N" -eq 0 ]; then echo "post-review: 0 comments in payload - nothing to post" >&2; exit 0; fi

ME=$(gh api user --jq '.login' 2>/dev/null) || { echo "post-review: gh api user failed (not authenticated?)" >&2; exit 4; }

# An existing PENDING review by the current user stops the run.
REVIEWS=$(gh api "repos/$OR/pulls/$PR/reviews" --paginate 2>/dev/null || echo '[]')
PID=$(printf '%s' "$REVIEWS" | jq -r --arg me "$ME" 'map(select(.state=="PENDING" and .user.login==$me))[0].id // empty')
if [ -n "$PID" ]; then
  echo "post-review: STOP - $ME already has pending review $PID on $OR#$PR; nothing added. Submit or discard it, then re-run." >&2
  exit 6
fi

echo "post-review: user=$ME mode=create-pending payload=$N comments dry_run=$DRY" >&2
if [ "$DRY" -eq 1 ]; then
  echo "--- DRY RUN: would create a pending review with these comments ---" >&2
  jq -r '.[] | "  " + .path + ":" + (.line|tostring) + "  " + (.body[0:60])' "$PAYLOAD" >&2 || true
  exit 0
fi

REQ=$(mktemp); trap 'rm -f "$REQ"' EXIT
HEAD=$(gh api "repos/$OR/pulls/$PR" --jq '.head.sha' 2>/dev/null)
BODY=""; [ -n "$BODYFILE" ] && [ -f "$BODYFILE" ] && BODY=$(cat "$BODYFILE")
BODY="$AI_DISCLAIMER
$BODY"
jq -n --arg cid "$HEAD" --arg body "$BODY" --slurpfile cs "$PAYLOAD" \
  '{commit_id: $cid, body: $body, comments: ($cs[0] | map({path,line,side,body}))}' > "$REQ"
URL=$(gh api "repos/$OR/pulls/$PR/reviews" --method POST --input "$REQ" --jq '.html_url' 2>&1) \
  || { echo "post-review: create failed: $URL" >&2; exit 5; }
echo "post-review: created PENDING review (not submitted): $URL" >&2
printf '%s\n' "$URL"
